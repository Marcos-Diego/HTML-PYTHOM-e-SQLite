-- database: ./banco_de_dados.db

PRAGMA foreign_keys = ON;
--===============   itens   =================
CREATE TABLE IF NOT EXISTS itens(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nome TEXT NOT NULL,
    categoria INTEGER NOT NULL,
    descricao TEXT,
    local TEXT NOT NULL,
    data TEXT DEFAULT CURRENT_DATE,
    consevacao TEXT NOT NULL,
    situacao TEXT NOT NULL,
    FOREIGN KEY (categoria) REFERENCES categoria_item (id)
);

CREATE TABLE IF NOT EXISTS categoria_item(
    id INTEGER NOT NULL PRIMARY KEY,
    nome TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS solicitacao(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    id_item INTEGER NOT NULL,
    usuario TEXT NOT NULL, --o py vai buscar que esta logado
    descricao TEXT
);
CREATE TABLE IF NOT EXISTS registro(
    id INTEGER PRIMARY KEy,
    nome TEXT NOT NULL,
    categoria INTEGER NOT NULL,
    descricao TEXT,
    local TEXT NOT NULL,
    data TEXT DEFAULT CURRENT_DATE,
    consevacao TEXT NOT NULL,
    situacao TEXT NOT NULL,
    modificacao_data TEXT NOT NULL,
    modificado_por TEXT NOT NULL, --vai buscar que esta logado
    retirado_por TEXT NOT NULL,
    FOREIGN KEY(categoria) REFERENCES categoria_item(id)
);

--===============   Cadastro   =================
CREATE TABLE IF NOT EXISTS cargo(
    id INTEGER NOT NULL PRIMARY KEY,
    nome TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS pessoa(
    cpf TEXT NOT NULL PRIMARY KEY,
    nome TEXT NOT NULL,
    email TEXT NOT NULL,
    senha TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS funcionario(
    cpf TEXT NOT NULL PRIMARY KEY,
    cargo TEXT NOT NULL,
    FOREIGN KEY(cargo) REFERENCES cargo (id)
);

CREATE TABLE IF NOT EXISTS aluno(
    cpf TEXT NOT NULL PRIMARY KEY,
    matricula TEXT NOT NULL
);

