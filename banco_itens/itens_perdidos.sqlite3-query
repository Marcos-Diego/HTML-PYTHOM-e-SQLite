CREATE TABLE IF NOT EXISTS Itens(
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    Nome TEXT NOT NULL,
    Descrição TEXT NOT NULL,
    Data DATE DEFAULT CURRENT_DATE,
    Local TEXT NOT NULL,
    Situação TEXT NOT NULL
);


